{
  "name": "@observablehq/inputs",
  "description": "Lightweight user interface components",
  "version": "1.0.0",
  "author": {
    "name": "Observable, Inc.",
    "url": "https://observablehq.com"
  },
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsdelivr": "dist/inputs.min.js",
  "unpkg": "dist/inputs.min.js",
  "exports": {
    ".": {
      "umd": "./dist/inputs.min.js",
      "default": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/observablehq/inputs.git"
  },
  "files": [
    "dist/**/*.css",
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "engines": {
    "node": ">=14.5.0"
  },
  "scripts": {
    "test": "mkdir -p test/output && mocha 'test/**/*-test.js' test/input.js",
    "lint": "eslint",
    "prepublishOnly": "rm -rf dist && rollup -c && node bin/clean-css < src/style.css > dist/index.css",
    "dev": "vite dev"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^3.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@uwdata/flechette": "^2.6.0",
    "apache-arrow": "^17.0.0",
    "clean-css": "^5.3.3",
    "d3": "^7.9.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^24.1.3",
    "jsesc": "^3.1.0",
    "mocha": "^10.8.2",
    "rollup": "^4.67.5",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "htl": "^1.0.0",
    "isoformat": "^0.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
